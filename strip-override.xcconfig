// strip-override.xcconfig
//
// Injected globally via the XCODE_XCCONFIG_FILE environment variable (NOT via a
// project's baseConfigurationReference), so it reaches EVERY target in the build
// — including the `libpd-ios` static-library target that lives in the `libpd`
// git submodule, which we deliberately do not modify.
//
// Why: on Xcode 26 / iOS 26 SDK, the archive-time Strip of libpd-ios.a shells out
// to `ld -r` to strip debug symbols (libpd is compiled with -g). That `ld -r`
// blocks in open()/mmap and stalls the archive for ~40 minutes. Disabling the
// install-time strip removes the step entirely. A static lib linked into the app
// needs no archive-time stripping; and the app's own dSYM is still generated.
//
// PRECEDENCE NOTE: XCODE_XCCONFIG_FILE is a HIGH-precedence global override — it
// beats even explicit per-target build settings. So this applies to *every*
// target, including the rwa-client app itself: the app binary is therefore also
// archived unstripped (larger binary, symbol table retained; crash symbolication
// still works via the dSYM). This is acceptable for our internal/kiosk builds.
// It is NOT possible to re-scope only libpd-ios via this mechanism; if the app
// must be stripped again, prebuild libpd-ios.a out of the archive graph instead.
//
// Usage (GUI archive) — pick one:
//   A) Launch Xcode via the repo wrapper:   ./open-xcode.sh
//   B) Machine-global (affects ALL Xcode builds on this Mac, needs Xcode relaunch):
//        launchctl setenv XCODE_XCCONFIG_FILE "$PWD/strip-override.xcconfig"
//
// Usage (CLI / CI archive):
//   XCODE_XCCONFIG_FILE="$PWD/strip-override.xcconfig" xcodebuild archive ...

STRIP_INSTALLED_PRODUCT = NO
