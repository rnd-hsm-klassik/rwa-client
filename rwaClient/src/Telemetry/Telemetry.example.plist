<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Template for the telemetry gateway config (PROJECT-PLAN.md §6).
  Copy this file to Telemetry.plist (same directory) and fill in the real
  values. Telemetry.plist is gitignored — never commit the ingest token.

  UnitId is an optional dev/simulator override of the unit label
  (device_id, PROJECT-PLAN.md §1.1). Leave it out (or empty) on real
  phones: the label then comes from Settings -> Unit ID.
-->
<dict>
	<key>UnitId</key>
	<string></string>
	<key>BaseURL</key>
	<string>https://TELEMETRY-BACKEND-HOST</string>
	<key>IngestToken</key>
	<string>INGEST_TOKEN_HERE</string>
</dict>
</plist>
