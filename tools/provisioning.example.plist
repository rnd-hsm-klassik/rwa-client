<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-phone settings for RWA Player, pushed by deploy_games.sh -s <plist>.

  One dictionary per phone, keyed by the phone's hardware UDID (as shown by
  `pymobiledevice3 usbmux list` or devicectl's hardwareProperties.udid); the
  script pushes each discovered phone's entry as Documents/player-settings.plist.

  The app applies the pushed entry to its settings once per file content at
  next launch (ProvisioningLoader.swift), so later manual changes on the phone
  survive relaunches; push a changed entry to override them again.

  Identity per the glossary (PROJECT-PLAN.md par. 1.1): the *unit* is
  phone + headset assembly; its label (rwa-hs-N) is the telemetry device_id,
  the phone's WiFi hotspot name, and - by convention - the assembly's BLE
  name, so a unit normally needs only unitId.

  All keys inside an entry are optional. Omit what should stay untouched:
    unitId            unit label (rwa-hs-N): device_id in the backend
                      = hotspot name = the assembly BLE name to connect to
    assemblyId        override of the BLE name to connect to; set it ONLY
                      when this phone runs with an assembly that is not its
                      unit's own (a spare, an RWAHT, or an un-provisioned
                      board advertising rtkrover-<chip-id>). Equal to
                      unitId it is dropped as redundant.
    gpsSource         "rtk" (RTK headtracker) or "internal" (phone GPS)
    useHeadtracker    heading from the assembly IMU (true) or CoreMotion (false)
    inverseElevation  flip the elevation sign from the tracker
    calibrateOnStart  run north calibration automatically when a walk starts
    defaultGame       game to auto-load at launch: Documents-relative .rwa path
    creatorIP         IP of the machine running RWA Creator (OSC simulator)

  Deprecated aliases, still applied (with a log notice): deviceId -> unitId,
  headtrackerId -> assemblyId.
-->

<plist version="1.0">
<dict>
	<!-- The normal case: one label covers device_id, hotspot and BLE name. -->
	<key>00008030-001E0F42B10702E</key>
	<dict>
		<key>unitId</key>
		<string>rwa-hs-1</string>
		<key>gpsSource</key>
		<string>rtk</string>
		<key>useHeadtracker</key>
		<true/>
		<key>defaultGame</key>
		<string>rwatest.rwa</string>
	</dict>

	<!-- Unit running a stand-in assembly: telemetry stays rwa-hs-2, but the
	     phone connects to an un-provisioned board's fallback BLE name. -->
	<key>00008000-0000000001234567</key>
	<dict>
		<key>unitId</key>
		<string>rwa-hs-2</string>
		<key>assemblyId</key>
		<string>rtkrover-ca0ca7</string>
		<key>gpsSource</key>
		<string>rtk</string>
		<key>useHeadtracker</key>
		<true/>
	</dict>
</dict>
</plist>
